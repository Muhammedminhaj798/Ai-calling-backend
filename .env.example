# Copy to .env and fill in real values. Never commit .env.
# Every variable here is validated at boot by src/config/env.ts.

NODE_ENV=development
PORT=4000

# Local PostgreSQL 16 for development. Replace USER and PASSWORD with your local
# database credentials and create the database first:
#   createdb ai_pharmacy_agent
# The server refuses to start until PROTECTED_DATABASE_IDENTITIES is set (see "Production database protection"
# below); a localhost database also needs DATABASE_CONFIRMED_SEPARATE.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/ai_pharmacy_agent

# Browser origin allowed to call this API (the Next.js dashboard).
CORS_ORIGIN=http://localhost:3000
# Reverse-proxy hops whose X-Forwarded-For entries are trusted for the client IP (rate limits, audit logs).
# 0 = trust none. Set only to a value measured from real traffic (README → Deploy); too high allows IP spoofing.
TRUST_PROXY_HOPS=0

# debug | info | warn | error
LOG_LEVEL=info

# --- Staff authentication -------------------------------------------------
# Random secret of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Optional: attempts per 15 minutes (defaults shown)
# LOGIN_RATE_LIMIT_PER_IP=20
# LOGIN_RATE_LIMIT_PER_EMAIL=10
# REFRESH_RATE_LIMIT_PER_IP=60

# Optional: direct (non-pooled) connection used only by Prisma Migrate. Required with Neon's "-pooler"
# endpoint, where the migration advisory lock can hang; the app keeps using DATABASE_URL. prisma migrate / db
# refuse a "-pooler" host here (or in DATABASE_URL when this is unset) and a direct URL of another database.
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ai_pharmacy_agent

# --- Production database protection (API, voice worker, Prisma CLI, seed and integration runner) ---
# Databases no process may use by accident: comma-separated IDENTITIES, never URLs or credentials.
#   neon:<endpoint-id>/<database>        endpoint id = first label of the Neon host without "-pooler",
#                                        e.g. host ep-abc-123-pooler.c-2.us-east-2.aws.neon.tech, path /neondb
#                                        → neon:ep-abc-123/neondb
#   host:<hostname>:<port>/<database>    any other server;   loopback:<port>/<database>   localhost
#   <server>/*                           every database on that server
# Required in every environment, production included: until it is set the API and the voice worker refuse to start,
# and npm run test:integration, npm run seed and Prisma's database commands refuse to run.
# PROTECTED_DATABASE_IDENTITIES=neon:<production-endpoint-id>/<production-database>
#
# Production only (NODE_ENV=production, e.g. Render, on the API and the voice worker): lets the app use the protected
# database that DATABASE_URL names. Its exact identity, never a wildcard. Refused under any other NODE_ENV; when set it
# must match DATABASE_URL, so production cannot start on another database either.
# ALLOW_PROTECTED_RUNTIME_DATABASE=neon:<production-endpoint-id>/<production-database>
#
# Only when DATABASE_URL is on a different host than the protected ones (e.g. localhost against Neon), so no guard can
# prove it separate: its exact identity, once you have verified it yourself. Read by startup, the Prisma guard and the
# seed; it never unlocks a protected database.
# DATABASE_CONFIRMED_SEPARATE=loopback:5432/ai_pharmacy_agent
#
# Prisma command guard (prisma.config.ts → scripts/prisma-guard.ts). Every Prisma command that can reach a database
# (migrate, db, studio, bootstrap, postgres link, mcp) refuses until PROTECTED_DATABASE_IDENTITIES is set, and never
# runs against a protected database. --url, --from-url, --to-url and other URL flags are refused on every command.
# Only `migrate deploy` / `migrate status` may run on a protected database, one command at a time, with its exact
# identity set in the shell for that command (never saved in this file; separate from the runtime setting above):
#   $env:ALLOW_PROTECTED_MIGRATE_DEPLOY='neon:<endpoint-id>/<database>'; npx prisma migrate deploy; Remove-Item Env:ALLOW_PROTECTED_MIGRATE_DEPLOY

# --- Integration tests (read by `npm run test:integration`) ---
# Must be a separate database: the tests truncate every table. The server also checks it at startup: production
# refuses to start when DATABASE_URL is this database; development starts with a warning. The runner refuses unless scripts/db-guard.ts
# proves it differs from DATABASE_URL and DIRECT_DATABASE_URL (another database name on the same server, or
# another Neon endpoint). A Neon pooled and direct URL of one database count as the SAME database.
# With Neon the runner derives the direct host automatically; set TEST_DIRECT_DATABASE_URL to override.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/ai_pharmacy_agent_test
# Only when the guard cannot tell (different hosts) and you have verified separation yourself: the identity
# the refusal prints, e.g. loopback:5432/ai_pharmacy_agent_test
# TEST_DATABASE_CONFIRMED_SEPARATE=

# --- Inventory -------------------------------------------------------------
# mock = simulated stock from the local inventory table; client_api = the production adapter, which
# stays non-functional until the client documents its API (ARCHITECTURE.md §B.6, §G-3/4).
INVENTORY_ADAPTER=mock
# Required only when INVENTORY_ADAPTER=client_api
# CLIENT_INVENTORY_BASE_URL=https://inventory.example.com
# CLIENT_INVENTORY_API_KEY=...

# --- Orders and reservations (defaults shown) -------------------------------
MAX_ORDER_ITEMS=15
RESERVATION_TTL_HOURS=24
# 0 disables the in-process expiry sweeper and idle-session sweeper (tests)
RESERVATION_SWEEP_INTERVAL_SECONDS=60

# --- AI conversation engine (build step 4) --------------------------------
# mock = scripted provider (tests, local runs); anthropic = Claude (production); openai = Chat Completions.
# A failing real provider hands the call to staff; it never falls back to the mock.
AI_PROVIDER=mock
# Required when AI_PROVIDER=anthropic. Set it in the shell or the host's secret store, never in Git.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — thinking depth; low keeps phone latency down, medium if quality drops
ANTHROPIC_EFFORT=low
ANTHROPIC_TIMEOUT_MS=20000
# USD per 1M tokens, only to fill usage_costs (claude-opus-5-5 list price: 4 input / 20 output)
ANTHROPIC_PRICE_INPUT_USD_PER_1M=0
ANTHROPIC_PRICE_OUTPUT_USD_PER_1M=0
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=20000
# USD per 1M tokens, only to fill usage_costs (0 = record tokens without a cost)
OPENAI_PRICE_INPUT_USD_PER_1M=0
OPENAI_PRICE_OUTPUT_USD_PER_1M=0
AI_MAX_TOOL_ROUNDS=8
AI_HISTORY_MESSAGES=60
# en | ml | ta | hi — used before the caller is identified or detected
DEFAULT_LANGUAGE=en
CONVERSATION_IDLE_TIMEOUT_MINUTES=30

# Speech: mock for tests/local runs; google = Cloud Speech-to-Text / Text-to-Speech over REST;
# sarvam = Sarvam AI saaras (speech-to-text) / bulbul (text-to-speech) over REST. Real providers are billable.
STT_PROVIDER=mock
TTS_PROVIDER=mock
# GOOGLE_SPEECH_API_KEY=...
# SARVAM_API_KEY=<from the Sarvam dashboard; secret, never commit>
# SARVAM_STT_MODEL=saaras:v4
# auto = Sarvam detects each utterance's language; session = the call's current language
# SARVAM_STT_LANGUAGE=auto
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh

# Telephony: mock for tests/local runs; exotel = inbound webhooks + Voicebot media stream; none = no phone line
# connected (webhooks and media stream answer 404; LiveKit browser test calls still work).
# Production refuses to start with AI_PROVIDER, STT_PROVIDER, TTS_PROVIDER or TELEPHONY_PROVIDER set to mock or
# left unset, and needs INVENTORY_ADAPTER set explicitly (mock is accepted with a warning until the database
# adapter exists). Use TELEPHONY_PROVIDER=none in production until a phone line (LiveKit SIP) is connected.
# Configure Exotel with https://<host>/webhooks/telephony/exotel/<EXOTEL_WEBHOOK_SECRET>/incoming,
# .../status and wss://<host>/ws/telephony/exotel/<EXOTEL_WEBHOOK_SECRET>
TELEPHONY_PROVIDER=mock
# EXOTEL_WEBHOOK_SECRET=<random, at least 16 characters>
# EXOTEL_ALLOWED_IPS=1.2.3.4,5.6.7.8
# HANDOVER_PHONE_NUMBER=+91XXXXXXXXXX
VAD_RMS_THRESHOLD=450

# LiveKit browser voice calls (README "LiveKit voice calls"). The API endpoint POST /api/voice/sessions is off
# unless LIVEKIT_ENABLED=true; the voice worker (npm run voice-worker:dev / :start) always needs URL, key and
# secret. API and worker must use the same four values. Keep the secret out of Git and out of the frontend.
LIVEKIT_ENABLED=false
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=<from LiveKit Cloud → Settings → API keys>
# LIVEKIT_API_SECRET=<same place; secret value>
# One name per environment, so a local worker never takes another environment's calls
LIVEKIT_AGENT_NAME=pharmacy-voice-local
# Warm job processes in the worker; each loads the whole backend (memory), so 1 on small instances
LIVEKIT_WORKER_IDLE_PROCESSES=1

# --- Development-only admin seed (read by `npm run seed`, not by the server) ---
# The seed refuses NODE_ENV=production, PROTECTED_DATABASE_IDENTITIES and TEST_DATABASE_URL, prints the masked
# target and asks you to type its database name. An existing admin is left unchanged (--reset-admin resets it).
# A target on a different host than a protected one (e.g. localhost) also needs DATABASE_CONFIRMED_SEPARATE (above).
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=choose-a-long-password
