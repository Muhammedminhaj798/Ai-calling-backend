# Copy to .env and fill in real values. Never commit .env.
# Every variable here is validated at boot by src/config/env.ts.

NODE_ENV=development
PORT=4000

# Local PostgreSQL 16 for development. Replace USER and PASSWORD with your local
# database credentials and create the database first:
#   createdb ai_pharmacy_agent
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/ai_pharmacy_agent

# Browser origin allowed to call this API (the Next.js dashboard).
CORS_ORIGIN=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info

# --- Staff authentication -------------------------------------------------
# Random secret of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Optional: attempts per 15 minutes (defaults shown)
# LOGIN_RATE_LIMIT_PER_IP=20
# LOGIN_RATE_LIMIT_PER_EMAIL=10
# REFRESH_RATE_LIMIT_PER_IP=60

# Optional: direct (non-pooled) connection used only by Prisma Migrate. Required with Neon's "-pooler"
# endpoint, where the migration advisory lock can hang; the app keeps using DATABASE_URL.
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ai_pharmacy_agent

# --- Integration tests (read by `npm run test:integration`, never by the server) ---
# Must be a separate database: the tests truncate every table. With Neon the runner derives the direct
# host automatically; set TEST_DIRECT_DATABASE_URL to override.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/ai_pharmacy_agent_test

# --- Inventory -------------------------------------------------------------
# mock = simulated stock from the local inventory table; client_api = the production adapter, which
# stays non-functional until the client documents its API (ARCHITECTURE.md §B.6, §G-3/4).
INVENTORY_ADAPTER=mock
# Required only when INVENTORY_ADAPTER=client_api
# CLIENT_INVENTORY_BASE_URL=https://inventory.example.com
# CLIENT_INVENTORY_API_KEY=...

# --- Orders and reservations (defaults shown) -------------------------------
MAX_ORDER_ITEMS=15
RESERVATION_TTL_HOURS=24
# 0 disables the in-process expiry sweeper and idle-session sweeper (tests)
RESERVATION_SWEEP_INTERVAL_SECONDS=60

# --- AI conversation engine (build step 4) --------------------------------
# mock = scripted provider (tests, local runs); openai = real model calls
AI_PROVIDER=mock
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=20000
# USD per 1M tokens, only to fill usage_costs (0 = record tokens without a cost)
OPENAI_PRICE_INPUT_USD_PER_1M=0
OPENAI_PRICE_OUTPUT_USD_PER_1M=0
AI_MAX_TOOL_ROUNDS=8
AI_HISTORY_MESSAGES=60
# en | ml | ta | hi — used before the caller is identified or detected
DEFAULT_LANGUAGE=en
CONVERSATION_IDLE_TIMEOUT_MINUTES=30

# Speech: mock for tests/local runs; google = Cloud Speech-to-Text / Text-to-Speech over REST
STT_PROVIDER=mock
TTS_PROVIDER=mock
# GOOGLE_SPEECH_API_KEY=...

# Telephony: mock for tests/local runs; exotel = inbound webhooks + Voicebot media stream.
# Configure Exotel with https://<host>/webhooks/telephony/exotel/<EXOTEL_WEBHOOK_SECRET>/incoming,
# .../status and wss://<host>/ws/telephony/exotel/<EXOTEL_WEBHOOK_SECRET>
TELEPHONY_PROVIDER=mock
# EXOTEL_WEBHOOK_SECRET=<random, at least 16 characters>
# EXOTEL_ALLOWED_IPS=1.2.3.4,5.6.7.8
# HANDOVER_PHONE_NUMBER=+91XXXXXXXXXX
VAD_RMS_THRESHOLD=450

# --- Development-only admin seed (read by `npm run seed`, not by the server) ---
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=choose-a-long-password
