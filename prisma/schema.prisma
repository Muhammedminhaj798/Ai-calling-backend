// Prisma schema — mirrors ARCHITECTURE.md §D (tables, enums, indexes).
// CHECK constraints that Prisma cannot express are appended to the initial migration SQL.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, citext]
}

// ---------------------------------------------------------------------------
// Enumerations (§D.2)
// ---------------------------------------------------------------------------

enum Language {
  en
  ml
  ta
  hi

  @@map("language")
}

enum CallStatus {
  ringing
  in_progress
  completed
  handed_over
  failed

  @@map("call_status")
}

/// AI conversation state (ARCHITECTURE.md §A.4). Transitions enforced in modules/ai/conversation.state.ts.
enum ConversationState {
  initializing
  identifying_customer
  confirming_location
  collecting_items
  matching_products
  checking_inventory
  reviewing_shortages
  building_order
  reading_back
  waiting_customer_confirmation
  handover_required
  completed
  failed

  @@map("conversation_state")
}

enum Speaker {
  customer
  agent
  system

  @@map("speaker")
}

/// Order lifecycle (ARCHITECTURE.md §A.5). Transitions are enforced in modules/orders/orders.state.ts.
enum OrderStatus {
  draft
  pending_customer_confirmation
  customer_confirmed
  pending_stock_reservation
  pending_staff_approval
  approved
  rejected
  cancelled
  failed
  fulfilled

  @@map("order_status")
}

enum OrderItemStatus {
  /// Resolved to a catalogue product
  active
  /// Caller's words kept, no catalogue product yet — staff must resolve or remove
  flagged

  @@map("order_item_status")
}

/// Result of the most recent stock check for a line
enum ItemStockStatus {
  unchecked
  in_stock
  insufficient
  out_of_stock
  unknown
  error

  @@map("item_stock_status")
}

/// What the customer said about a line during read-back
enum CustomerDecision {
  pending
  accepted
  declined

  @@map("customer_decision")
}

enum ConfirmationStatus {
  pending
  confirmed
  superseded

  @@map("confirmation_status")
}

enum ConfirmationSource {
  phone_ai
  phone_staff
  manual

  @@map("confirmation_source")
}

enum ReservationStatus {
  active
  consumed
  released
  expired

  @@map("reservation_status")
}

enum ExceptionType {
  product_not_found
  ambiguous_product
  insufficient_stock
  out_of_stock
  inventory_api_error
  customer_not_registered
  customer_not_eligible
  reservation_failed
  reservation_expired
  customer_unconfirmed
  order_validation_failed
  human_handover_required
  low_confidence
  call_dropped_with_draft
  duplicate_suspected

  @@map("exception_type")
}

enum ExceptionStatus {
  open
  in_progress
  resolved
  dismissed

  @@map("exception_status")
}

enum ApprovalDecision {
  approved
  rejected
  modified

  @@map("approval_decision")
}

enum CostService {
  telephony
  stt
  llm
  tts

  @@map("cost_service")
}

enum StaffRole {
  admin
  staff
  approver

  @@map("staff_role")
}

enum CustomerStatus {
  active
  inactive
  blocked

  @@map("customer_status")
}

enum ProductStatus {
  active
  inactive
  discontinued

  @@map("product_status")
}

enum InventorySource {
  mock
  client_api
  manual

  @@map("inventory_source")
}

// ---------------------------------------------------------------------------
// Master data
// ---------------------------------------------------------------------------

/// Client's customer master — retail pharmacies that call in.
model Customer {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalCode      String   @unique @map("external_code")
  name              String
  /// E.164
  phonePrimary      String   @unique @map("phone_primary")
  /// E.164, used for caller-ID lookup
  phoneAlternates   String[]       @default([]) @map("phone_alternates")
  email             String?
  gstin             String?
  drugLicenseNo     String?        @map("drug_license_no")
  preferredLanguage Language       @default(en) @map("preferred_language")
  /// Only `active` customers go through the automated ordering workflow
  status            CustomerStatus @default(active)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  addresses  CustomerAddress[]
  calls      Call[]
  orders     Order[]
  exceptions Exception[]

  @@index([phoneAlternates], type: Gin)
  @@index([status])
  @@map("customers")
}

/// Delivery addresses — a customer may have several; at most one is the default.
model CustomerAddress {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  label      String   @default("Default")
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([customerId])
  @@map("customer_addresses")
}

/// Client's product catalogue. The AI may only reference rows from this table.
model Product {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Client SKU
  externalCode String        @unique @map("external_code")
  /// Full product name as sold, e.g. "Dolo 650"
  name         String
  /// Brand family, e.g. "Dolo" — used for filtering
  brand        String?
  genericName  String?       @map("generic_name")
  /// e.g. "650 mg"
  strength     String?
  /// Dosage form, e.g. "tablet", "syrup"
  form         String?
  /// e.g. "15x10", "100 ml"
  packSize     String        @map("pack_size")
  /// Selling unit, e.g. "strip", "bottle", "box"
  unit         String?
  manufacturer String?
  mrpPaise     Int?          @map("mrp_paise")
  /// Price to retailer — pricing rules pending (§G-6)
  ptrPaise     Int?          @map("ptr_paise")
  gstRate      Decimal?      @map("gst_rate") @db.Decimal(4, 2)
  status       ProductStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventory    Inventory?
  orderItems   OrderItem[]
  reservations StockReservation[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([genericName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([brand])
  @@index([status])
  @@map("products")
}

/// Local stock view: mock data now, cache of the client inventory API later.
/// CHECK (quantity_available >= 0), CHECK (quantity_reserved BETWEEN 0 AND quantity_available) — in migration SQL.
model Inventory {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String          @unique @map("product_id") @db.Uuid
  quantityAvailable Int             @map("quantity_available")
  quantityReserved  Int             @default(0) @map("quantity_reserved")
  source            InventorySource
  syncedAt          DateTime        @map("synced_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])

  @@map("inventory")
}

// ---------------------------------------------------------------------------
// Calls and transcripts
// ---------------------------------------------------------------------------

model Call {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// "exotel" | "twilio"
  provider        String
  /// Provider call id — webhook idempotency key
  providerCallSid String     @unique @map("provider_call_sid")
  direction       String     @default("inbound")
  fromNumber      String     @map("from_number")
  toNumber        String     @map("to_number")
  customerId      String?    @map("customer_id") @db.Uuid
  status          CallStatus
  language        Language?
  startedAt       DateTime   @map("started_at") @db.Timestamptz(6)
  answeredAt      DateTime?  @map("answered_at") @db.Timestamptz(6)
  endedAt         DateTime?  @map("ended_at") @db.Timestamptz(6)
  durationSeconds Int?       @map("duration_seconds")
  recordingUrl      String?           @map("recording_url")
  handoverReason    String?           @map("handover_reason")
  aiSummary         String?           @map("ai_summary")
  /// Where the AI conversation currently is; the call row is the conversation session
  conversationState ConversationState @default(initializing) @map("conversation_state")
  lastActivityAt    DateTime?         @map("last_activity_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer    Customer?    @relation(fields: [customerId], references: [id])
  transcripts Transcript[]
  events      CallEvent[]
  order       Order?
  exceptions  Exception[]
  usageCosts  UsageCost[]

  @@index([customerId])
  @@index([startedAt(sort: Desc)])
  @@index([status])
  @@index([conversationState])
  @@map("calls")
}

/// Conversation history for the dashboard: state changes, tool executions (with outcome), handovers,
/// provider errors. Transcript text lives in `transcripts`.
model CallEvent {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId     String             @map("call_id") @db.Uuid
  /// session_started, state_changed, tool_called, tool_failed, provider_error, handover_requested, session_ended, …
  type       String
  fromState  ConversationState? @map("from_state")
  toState    ConversationState? @map("to_state")
  toolName   String?            @map("tool_name")
  toolCallId String?            @map("tool_call_id")
  ok         Boolean?
  data       Json?
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, createdAt])
  @@index([type])
  @@map("call_events")
}

model Transcript {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId     String    @map("call_id") @db.Uuid
  sequence   Int
  speaker    Speaker
  text       String
  language   Language?
  /// STT confidence for finals, 0.000–1.000
  confidence Decimal?  @db.Decimal(4, 3)
  offsetMs   Int?      @map("offset_ms")
  durationMs Int?      @map("duration_ms")
  /// Tool name + args + result summary for agent turns
  toolCalls  Json?     @map("tool_calls")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, sequence])
  @@map("transcripts")
}

// ---------------------------------------------------------------------------
// Orders, lines, reservations
// ---------------------------------------------------------------------------

model Order {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable, e.g. PO-20261110-00042 (sequence order_number_seq, created in migration SQL)
  orderNumber           String      @unique @map("order_number")
  /// One order per call
  callId                String?     @unique @map("call_id") @db.Uuid
  customerId            String      @map("customer_id") @db.Uuid
  status                OrderStatus @default(draft)
  /// Incremented on every line change; a read-back and its confirmation are bound to one revision
  revision              Int         @default(1)
  customerPoReference   String?     @map("customer_po_reference")
  /// Delivery location confirmed with the customer (one of their customer_addresses)
  deliveryAddressId     String?     @map("delivery_address_id") @db.Uuid
  /// Idempotency-Key of the creating request
  idempotencyKey        String?     @unique @map("idempotency_key")
  /// Idempotency-Key of the reservation request that produced the active reservations
  reserveIdempotencyKey String?     @map("reserve_idempotency_key")
  subtotalPaise         Int         @default(0) @map("subtotal_paise")
  taxPaise              Int         @default(0) @map("tax_paise")
  totalPaise            Int         @default(0) @map("total_paise")
  currency              String      @default("INR") @db.Char(3)
  /// "ai", "system" or a staff user id
  createdBy             String      @map("created_by")
  notes                 String?
  customerConfirmedAt   DateTime?   @map("customer_confirmed_at") @db.Timestamptz(6)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  call            Call?               @relation(fields: [callId], references: [id])
  customer        Customer            @relation(fields: [customerId], references: [id])
  deliveryAddress CustomerAddress?    @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  reservations  StockReservation[]
  confirmations OrderConfirmation[]
  events        OrderEvent[]
  approvals     StaffApproval[]
  exceptions    Exception[]

  @@index([status, createdAt])
  @@index([customerId, createdAt(sort: Desc)])
  @@map("orders")
}

/// Every status change and line change, for order history.
model OrderEvent {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  /// e.g. created, status_changed, item_added, item_updated, item_removed, readback_issued, customer_confirmed,
  /// reservation_succeeded, reservation_failed, reservation_released, reservation_expired, approved, rejected, cancelled
  type       String
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus? @map("to_status")
  /// staff | system | ai
  actorType  String       @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  reason     String?
  data       Json?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// A read-back issued to the customer for one revision, and whether they confirmed it.
/// Customer confirmation is separate from staff approval (staff_approvals).
model OrderConfirmation {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String             @map("order_id") @db.Uuid
  revision       Int
  status         ConfirmationStatus @default(pending)
  /// Lines as read back to the customer
  itemsSnapshot  Json               @map("items_snapshot")
  readbackText   String             @map("readback_text")
  readbackAt     DateTime           @default(now()) @map("readback_at") @db.Timestamptz(6)
  source         ConfirmationSource?
  confirmedAt    DateTime?          @map("confirmed_at") @db.Timestamptz(6)
  idempotencyKey String?            @unique @map("idempotency_key")
  /// staff | ai | system
  actorType      String?            @map("actor_type")
  actorId        String?            @map("actor_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, revision])
  @@map("order_confirmations")
}

/// CHECK (quantity > 0) and CHECK (status <> 'active' OR product_id IS NOT NULL) — in migration SQL.
model OrderItem {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String           @map("order_id") @db.Uuid
  lineNo           Int              @map("line_no")
  /// Null while a flagged line is unresolved
  productId        String?          @map("product_id") @db.Uuid
  /// Caller's words, verbatim
  requestedText    String           @map("requested_text")
  quantity         Int
  // --- catalogue snapshot at the time the line was resolved (never trusted from the client) ---
  nameSnapshot     String?          @map("name_snapshot")
  brandSnapshot    String?          @map("brand_snapshot")
  strengthSnapshot String?          @map("strength_snapshot")
  formSnapshot     String?          @map("form_snapshot")
  packSizeSnapshot String?          @map("pack_size_snapshot")
  unitSnapshot     String?          @map("unit_snapshot")
  /// Snapshot of products.ptr_paise
  unitPricePaise   Int?             @map("unit_price_paise")
  lineTotalPaise   Int?             @map("line_total_paise")
  /// Catalogue similarity score, 0.000–1.000
  matchConfidence  Decimal?         @map("match_confidence") @db.Decimal(4, 3)
  stockStatus      ItemStockStatus  @default(unchecked) @map("stock_status")
  stockCheckedAt   DateTime?        @map("stock_checked_at") @db.Timestamptz(6)
  availableAtCheck Int?             @map("available_at_check")
  customerDecision CustomerDecision @default(pending) @map("customer_decision")
  status           OrderItemStatus  @default(active)
  flagReason       String?          @map("flag_reason")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?           @relation(fields: [productId], references: [id])
  reservations StockReservation[]
  exceptions   Exception[]

  @@unique([orderId, lineNo])
  @@map("order_items")
}

/// CHECK (quantity > 0) — in migration SQL. At most one `active` row per order item (enforced by the
/// reservation service under the order's pending_stock_reservation lock).
model StockReservation {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                String            @map("order_id") @db.Uuid
  orderItemId            String            @map("order_item_id") @db.Uuid
  productId              String            @map("product_id") @db.Uuid
  quantity               Int
  status                 ReservationStatus
  /// mock | client_api — which provider confirmed this reservation
  provider               String
  /// Provider's reservation reference
  externalReservationRef String?           @map("external_reservation_ref")
  /// Key sent to the provider so retries never double-reserve
  idempotencyKey         String?           @map("idempotency_key")
  expiresAt              DateTime          @map("expires_at") @db.Timestamptz(6)
  releasedAt             DateTime?         @map("released_at") @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([orderId, status])
  @@index([orderItemId])
  @@index([productId, status])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

// ---------------------------------------------------------------------------
// Staff review: exceptions and approvals
// ---------------------------------------------------------------------------

model Exception {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           ExceptionType
  status         ExceptionStatus @default(open)
  callId         String?         @map("call_id") @db.Uuid
  customerId     String?         @map("customer_id") @db.Uuid
  orderId        String?         @map("order_id") @db.Uuid
  orderItemId    String?         @map("order_item_id") @db.Uuid
  description    String
  /// Structured context, e.g. requested text, candidate SKUs, shortages
  details        Json?
  assignedTo     String?         @map("assigned_to") @db.Uuid
  resolutionNote String?         @map("resolution_note")
  resolvedById   String?         @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?       @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  call       Call?      @relation(fields: [callId], references: [id])
  customer   Customer?  @relation(fields: [customerId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id])
  orderItem  OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  assignee   StaffUser? @relation("ExceptionAssignee", fields: [assignedTo], references: [id])
  resolvedBy StaffUser? @relation("ExceptionResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([type, status])
  @@index([callId])
  @@index([orderId])
  @@index([customerId])
  @@index([assignedTo, status])
  @@map("exceptions")
}

model StaffApproval {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String           @map("order_id") @db.Uuid
  staffUserId String           @map("staff_user_id") @db.Uuid
  decision    ApprovalDecision
  fromStatus  OrderStatus      @map("from_status")
  toStatus    OrderStatus      @map("to_status")
  /// Required when decision = rejected (application rule)
  note        String?
  /// Diff of lines for decision = modified
  changes     Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  order     Order     @relation(fields: [orderId], references: [id])
  staffUser StaffUser @relation(fields: [staffUserId], references: [id])

  @@index([orderId, createdAt])
  @@map("staff_approvals")
}

// ---------------------------------------------------------------------------
// Costs, users, audit
// ---------------------------------------------------------------------------

model UsageCost {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId       String      @map("call_id") @db.Uuid
  service      CostService
  provider     String
  /// Minutes, tokens or characters
  units        Decimal     @db.Decimal(12, 3)
  /// minutes | input_tokens | cached_input_tokens | output_tokens | characters
  unitType     String      @map("unit_type")
  /// USD cost × 1 000 000
  costMicroUsd BigInt      @map("cost_micro_usd")
  costPaise    Int?        @map("cost_paise")
  /// INR per USD used for cost_paise
  fxRate       Decimal?    @map("fx_rate") @db.Decimal(10, 4)
  /// Model / voice ids
  metadata     Json?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  call Call @relation(fields: [callId], references: [id])

  @@index([callId])
  @@index([createdAt])
  @@map("usage_costs")
}

model StaffUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.Citext
  /// argon2id
  passwordHash String    @map("password_hash")
  name         String
  role         StaffRole
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  approvals          StaffApproval[]
  assignedExceptions Exception[]     @relation("ExceptionAssignee")
  resolvedExceptions Exception[]     @relation("ExceptionResolver")
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]

  @@map("staff_users")
}

/// Refresh tokens are stored only as SHA-256 hashes. Rotation: each use revokes the row and
/// links its replacement; presenting an already-revoked token revokes the whole family.
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Append-only. The application DB role must not receive UPDATE/DELETE on this table.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// staff | system | ai
  actorType  String   @map("actor_type")
  /// staff_users.id when actor_type = staff
  actorId    String?  @map("actor_id") @db.Uuid
  /// e.g. order.approve, recording.access, customer.update
  action     String
  entityType String   @map("entity_type")
  /// Null for events without a persisted entity, e.g. a failed login for an unknown email
  entityId   String?  @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?  @db.Inet
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

